DATABASE_NAME=enacademy
DATABASE_USER=enacademy
DATABASE_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_PUBLIC_URL=http://localhost:3000
APP_ADMIN_NAME=ENAcademy Admin
APP_ADMIN_EMAIL=admin@enacademy.local
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_COOKIE_SECURE=false
DB_POOL_MAX=30
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT_MS=5000
SERVER_MAX_THREADS=200
SERVER_MIN_SPARE_THREADS=20
SERVER_ACCEPT_COUNT=200
SERVER_MAX_CONNECTIONS=1000
PASSWORD_RESET_MINUTES=60
TOKEN_RETENTION_DAYS=7
TOKEN_CLEANUP_CRON="0 20 3 * * *"
LOG_STRUCTURED_FORMAT=logstash
